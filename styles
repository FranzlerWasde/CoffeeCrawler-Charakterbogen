    /* Wir sprechen die Streamlit-Key-Klasse des Headers an */
#mein_mittelalter_header {
    font-family: 'Algerian', serif;
    color: #B3826C;          /* Kastanienbraun */
    font-size: 35px;
    text-align: center;
    text-shadow: 2px 2px 4px ;
    border-bottom: 2px double #B3826C;
    padding-bottom: 3px;
}


/* 1. Die gesamte Tab-Leiste (Hintergrund und Abstände) */
.st-key-mein_tab_system [data-baseweb="tab-list"] {
    /*background-color: #f0f2f6*/
    padding: 5px;
    border-radius: 8px 8px 0 0;
    gap: 5px;
}

/* 2. Alle inaktiven Tabs (Standard-Zustand) */
.st-key-mein_tab_system button[data-baseweb="tab"] {
    font-family: 'Times New Roman', serif;
    font-size: 20px;
    color: #555555;
    /*background-color: #e0e2e6;*/
    border-radius: 5px 5px 0 0;
    padding: 10px 20px;
}

/* 3. NUR der aktuell ausgewählte/aktive Tab */
.st-key-mein_tab_system button[aria-selected="true"] {

    color: #8B4513 !important;      /* Mittelalter-Braun */
    background-color: #FFF8DC !important; /* Pergament-Weiß */
    font-weight: bold;
    border-bottom: 2px solid #8B4513;

}

/* 4. Die dünne Standard-Unterlinie von Streamlit ausblenden */
.st-key-mein_tab_system [data-baseweb="tab-border"] {
    background-color: transparent !important;
}

.st-key-grosse_tabs button[data-baseweb="tab"] {
    font-size: 26px !important; /* Macht den Text riesig */
    padding: 25px 15px !important; /* Macht die Schaltflächen höher und breiter */

}


