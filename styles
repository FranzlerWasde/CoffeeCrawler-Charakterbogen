
/* style.css */

.st-key-text_inp {
        /* 1. Das eigentliche Eingabefeld (Input-Box) stylen */
    div[data-baseweb="input"] {
        margin-top: 0px;
    }

    /* 2. Zustand beim Reinklicken (Fokus) */
    div[data-baseweb="input"]:focus-within {
        border-color: #007bff !important;
        box-shadow: 0 0 8px rgba(0, 123, 255, 0.2);
        margin-top: 0px;

    }

    /* 3. Den darin liegenden Text anpassen */
    div[data-baseweb="input"] input {
        color: #B3826C;
        font-size: 16px;
        font-family: "Rye", Georgia, serif;
        margin-top: 0px;
    }

    /* 4. Den Platzhalter-Text (Placeholder) stylen */
    div[data-baseweb="input"] input::placeholder {
        color: #999999;
        font-style: italic;
    }

}


